# Copie para .env somente se precisar mudar os valores locais.
HOST=127.0.0.1
PORT=3001
MEDICARE_API_URL=http://127.0.0.1:3001
APP_ORIGIN=http://127.0.0.1:5173
MEDICARE_DB_PATH=data/medicare.sqlite
# Em uma hospedagem HTTPS, use a origem pública acima e cookies seguros.
MEDICARE_SECURE_COOKIES=false
# Na nuvem, configure DATABASE_URL somente no servidor e APP_ORIGIN com a URL HTTPS publicada.
# DATABASE_URL=postgresql://usuario:senha@host-do-pooler:6543/postgres
# Certificado de autoridade opcional, quando fornecido pela hospedagem do banco:
# MEDICARE_DB_CA_FILE=caminho/para/ca.crt
# Na Vercel, use MEDICARE_DB_CA_PEM com o conteúdo do certificado oficial.
